+name: m7-wp1-pr6-query-optimizer
+
+on:
+  push:
+  pull_request:
+
+jobs:
+  query-optimizer:
+    runs-on: ubuntu-latest
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - name: Install dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install pytest ruff
+
+      - name: Ruff
+        run: ruff check .
+
+      - name: Official version command
+        run: python -m quantis version
+
+      - name: Query Optimizer tests
+        run: python -m pytest tests/core/knowledge_graph/query_optimizer --cache-clear --import-mode=importlib
+
+      - name: Graph Query tests
+        run: python -m pytest tests/core/knowledge_graph/query --cache-clear --import-mode=importlib
+
+      - name: Knowledge Graph tests
+        run: python -m pytest tests/core/knowledge_graph --cache-clear --import-mode=importlib
+
+      - name: Current release gates
+        run: python -m pytest tests/release/current --cache-clear --import-mode=importlib
+
+      - name: Full test suite
+        run: python -m pytest --cache-clear --import-mode=importlib
